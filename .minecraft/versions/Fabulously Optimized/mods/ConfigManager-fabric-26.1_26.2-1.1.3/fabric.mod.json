  },
  "license": "GNU LGPLv3",
  "icon": "assets/config_manager/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.thebossmagnus.mods.config_manager.fabric.ConfigManagerFabric"
