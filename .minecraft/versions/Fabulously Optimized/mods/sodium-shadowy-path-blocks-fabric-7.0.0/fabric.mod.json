{
  "schemaVersion": 1,
  "id": "sspb",
  "version": "7.0.0",

  "name": "Sodium Shadowy Path Blocks",
  "description": "SSPB reintroduces vanilla-like smooth lighting to non-full blocks (e.g. dirt paths and how they have dark shading when directly next to a full block) when using Sodium.",
  "authors": [
    "Rynnavinx"
  ],
  "contact": {
    "sources": "https://github.com/Rynnavinx/sodium-shadowy-path-blocks",
    "issues": "https://github.com/Rynnavinx/sodium-shadowy-path-blocks/issues"
  },

  "license": "LGPLv3",
  "icon": "assets/sspb/textures/icon.png",

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/sodium-shadowy-path-blocks",
        "modmenu.curseforge" : "https://www.curseforge.com/minecraft/mc-mods/sodium-shadowy-path-blocks"
      }
    }
  },

  "environment": "client",
  "entrypoints": {
    "client": [
      "rynnavinx.sspb.fabric.client.SSPBFabricClientMod"
    ],
    "sodium:config_api_user": [
      "rynnavinx.sspb.common.client.options.SSPBConfigBuilder"
    ]
  },
  "mixins": [
    "sspb.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.0",
    "sodium": ">=0.8.7",
    "minecraft": ">=26.1"
  }
}
