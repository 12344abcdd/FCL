{
  "schemaVersion": 1,
  "id": "entity_texture_features",
  "version": "7.1.1",
  "name": "Entity Texture Features",
  "description": "Adds support for resource-pack driven features for entity textures including some OptiFine features
Supports OptiFine:
 - Random & Custom textures
 - Emissive textures
With more features such as:
 - Blinking textures
 - Player Skin support",
